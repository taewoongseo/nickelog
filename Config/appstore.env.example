// Copy this file to appstore.env (gitignored) and fill in real values.
// Used by /deploy to archive and upload a build to TestFlight via App Store Connect.
//
// 1. Create an API key at https://appstoreconnect.apple.com/access/api (role: App Manager or Admin).
//    This downloads a AuthKey_XXXXXXXXXX.p8 file ONCE — save it somewhere safe outside this repo.
// 2. Team ID is under https://developer.apple.com/account -> Membership.
// 3. Key ID and Issuer ID are shown on the App Store Connect API Keys page above.

APPLE_TEAM_ID=your_apple_team_id_here
APP_STORE_CONNECT_KEY_ID=your_key_id_here
APP_STORE_CONNECT_ISSUER_ID=your_issuer_id_here
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
